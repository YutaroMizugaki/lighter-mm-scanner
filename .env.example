# Local (default) or cloud
ENVIRONMENT=local

# Lighter public endpoints (overridable)
LIGHTER_REST_URL=https://mainnet.zklighter.elliot.ai
LIGHTER_WS_URL=wss://mainnet.zklighter.elliot.ai/stream?readonly=true

BOOK_SAMPLE_INTERVAL_SECONDS=5
PARQUET_ROTATION_MINUTES=15
GCS_UPLOAD_INTERVAL_MINUTES=15

# 0 = continuous; 72 = stop after 72h
RUN_TARGET_HOURS=0

# Cloud-only (leave empty locally)
GCP_PROJECT_ID=
GCP_REGION=asia-northeast1
GCS_BUCKET=
# Separate bucket for dashboard JSON only (public objectViewer OK)
GCS_PUBLIC_BUCKET=

# Injected by Cloud Build / Docker
GIT_SHA=
STRUCTURED_LOGGING=false
LIGHTER_MM_NO_DASHBOARD=0
